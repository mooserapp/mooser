{
  "name": "mooser",
  "productName": "Mooser",
  "version": "0.1.0",
  "description": "A calm, glassy home for your terminals and AI coding agents. Spaces, tabs, split panes, agent status, and side panels for skills, files, SSH servers and AI usage.",
  "main": "src/main/main.js",
  "author": "Mooser contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "electron scripts/icons.cjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.mooser.app",
    "productName": "Mooser",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "assets/**",
      "docs/**",
      "node_modules/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "npmRebuild": false
  }
}
